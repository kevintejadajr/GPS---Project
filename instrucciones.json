{
  "proyecto": "Sistema Inteligente De Evaluación De Aspirantes Docentes",
  "autores": ["Kevin Tejada", "Jose Maturana"],
  "stack_tecnologico": {
    "frontend": {
      "framework": "React",
      "estilos": "Tailwind CSS",
      "caracteristica_clave": "Componentes reutilizables para dashboards y formularios"
    },
    "backend": {
      "lenguaje": "Java 17",
      "framework": "Spring Boot",
      "responsabilidades": ["Lógica de negocio", "Autenticación", "Integración con módulo de IA"]
    },
    "base_de_datos": {
      "motor": "PostgreSQL",
      "uso": "Almacenamiento estructurado e integridad de reglas de evaluación"
    },
    "modulo_ia": {
      "herramienta": "API de LLM (ej. GeminiAI)",
      "funcion": "Extracción automática de datos desde archivos PDF/DOCX"
    }
  },
  "modelo_datos": {
    "entidades": [
      {
        "tabla": "Usuario",
        "atributos": {
          "id": "int",
          "nombre": "string",
          "email": "string",
          "password": "string",
          "tipo_rol": "string"
        }
      },
      {
        "tabla": "Convocatoria",
        "atributos": {
          "id": "int",
          "nombre_convocatoria": "string",
          "titulo": "string",
          "descripcion": "string",
          "fecha_cierre": "date"
        }
      },
      {
        "tabla": "Postulacion",
        "atributos": {
          "id": "int",
          "usuario_id": "int",
          "convocatoria_id": "int",
          "fecha_postulacion": "date",
          "estado": "string",
          "ruta_cv": "string"
        }
      },
      {
        "tabla": "Requisito",
        "atributos": {
          "id": "int",
          "descripcion": "string",
          "peso": "float",
          "valor_minimo": "float",
          "convocatoria_id": "int"
        }
      },
      {
        "tabla": "Resultado",
        "atributos": {
          "id": "int",
          "postulacion_id": "int",
          "puntaje_total": "float",
          "observaciones": "string"
        }
      }
    ]
  },
  "logica_negocio": {
    "clases_especiales": [
      {
        "nombre": "Aspirante",
        "hereda_de": "Usuario",
        "atributos_adicionales": ["hojaDeVida (file)", "datosExtraidos (json)", "puntajeFinal (float)"]
      },
      {
        "nombre": "MotorReglas",
        "atributos": ["list reglas"],
        "metodos": ["Resultado evaluar(Aspirante aspirante)"]
      }
    ],
    "casos_de_uso": [
      "Registro y Autenticación del Aspirante",
      "Gestión de Convocatorias (Admin)",
      "Carga y Procesamiento de CV con IA",
      "Configuración del Motor de Reglas (Admin)",
      "Evaluación Automática de Candidatos (Sistema)",
      "Visualización de Ranking de Aspirantes (Admin)"
    ]
  },
  "historias_de_usuario": [
    {
      "id": "HU01",
      "prioridad": "Alta",
      "rol": "Aspirante",
      "funcionalidad": "Registro y carga de CV (PDF/DOCX) para postulación automática"
    },
    {
      "id": "HU02",
      "prioridad": "Alta",
      "rol": "Aspirante",
      "funcionalidad": "Validación y corrección de datos extraídos por la IA antes de finalizar"
    },
    {
      "id": "HU03",
      "prioridad": "Alta",
      "rol": "Administrador",
      "funcionalidad": "Dashboard con ranking de aspirantes basado en requisitos"
    },
    {
      "id": "HU04",
      "prioridad": "Alta",
      "rol": "Administrador",
      "funcionalidad": "Definición de requisitos académicos y de experiencia para filtrado"
    }
  ]
}